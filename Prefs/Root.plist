<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>title</key><string>状态栏通知图标</string>
    <key>items</key>
    <array>
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>状态栏通知图标</string>
            <key>footerText</key><string>收到通知时短暂显示来源应用图标。可打开所有应用，或从已安装应用中逐个选择。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>启用插件</string>
            <key>defaults</key><string>com.minis.notifyicon</string>
            <key>key</key><string>ShowEnabled</string>
            <key>default</key><true/>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>所有应用</string>
            <key>defaults</key><string>com.minis.notifyicon</string>
            <key>key</key><string>AllAppsEnabled</string>
            <key>default</key><true/>
        </dict>
        <dict>
            <key>cell</key><string>PSLinkCell</string>
            <key>label</key><string>选择应用</string>
            <key>footerText</key><string>列出已安装应用及图标，并逐项开关。关闭“所有应用”后，所选应用生效。</string>
            <key>detail</key><string>NIAppListController</string>
            <key>isController</key><true/>
        </dict>
        <dict>
            <key>cell</key><string>PSSliderCell</string>
            <key>label</key><string>图标显示时长（秒）</string>
            <key>defaults</key><string>com.minis.notifyicon</string>
            <key>key</key><string>DisplayDuration</string>
            <key>default</key><real>8</real>
            <key>min</key><real>2</real>
            <key>max</key><real>30</real>
            <key>showValue</key><true/>
        </dict>
    </array>
</dict>
</plist>
